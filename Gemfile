source 'https://rubygems.org'

# Bundle Support's vendored CFPropertyList requires kconv (now in the nkf gem)
# and base64, both of which left the default gems in Ruby 3.4.
gem 'base64'
gem 'nkf'
gem 'nokogiri'
gem 'rspec'

# The have(n).things matcher the specs use was extracted from RSpec 3 core.
gem 'rspec-collection_matchers'
